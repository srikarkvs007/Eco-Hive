generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String   @id @default(uuid())
  name     String
  email    String   @unique
  password String
}

model Order {
  id             String   @id @default(uuid())
  pickupLocation String
  dropLocation   String
  packageType    String
  deliveryMode   String
  status         String   @default("Pending")
}

model Vehicle {
  id            String   @id @default(uuid())
  vehicleNumber String
  driverName    String
  vehicleType   String
}
